ENVIRONMENT=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=officeagent
POSTGRES_USER=officeagent
POSTGRES_PASSWORD=officeagent

REDIS_HOST=localhost
REDIS_PORT=6379

MILVUS_HOST=localhost
MILVUS_PORT=19530

CRM_MCP_URL=http://127.0.0.1:8101/mcp
DATABASE_MCP_URL=http://127.0.0.1:8102/mcp
KNOWLEDGE_MCP_URL=http://127.0.0.1:8103/mcp
REPORT_MCP_URL=http://127.0.0.1:8104/mcp

# Qwen via Alibaba Cloud Model Studio OpenAI-compatible API.
# Replace the API key with your DashScope/Model Studio key.
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=60
TAVILY_API_KEY=
